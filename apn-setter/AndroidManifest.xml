<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.porto.apnsetter"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk android:minSdkVersion="23" android:targetSdkVersion="23"/>

    <!-- signatureOrSystem on API 23 -> granted at install because the APK is
         platform-signed (same AOSP key as pttbridge). That's the whole trick. -->
    <uses-permission android:name="android.permission.WRITE_APN_SETTINGS"/>

    <application
        android:label="APN Setter"
        android:allowBackup="false">
        <!-- headless: launched by the watchdog daemon with the APN as extras -->
        <activity
            android:name=".ApnSetterActivity"
            android:exported="true"/>
        <!-- read-only: logs the current preferred APN to logcat tag ApnVerify -->
        <activity
            android:name=".VerifyActivity"
            android:exported="true"/>
    </application>
</manifest>
