# porto-watchdog config for TE300K
# Push to: /data/local/tmp/knob.conf

# IP or hostname of the machine running the remote watchdog (DNS supported)
host=192.168.1.100

# UDP port (must match UDP_PORT in docker-compose.yml)
port=4378

# Unique ID for this radio (max 8 chars, must match RADIOS env var)
radio_id=radio01

# Secret (must match SECRET or this radio's entry in SECRETS)
# Generate with: docker run --rm rsmcx1/porto-watchdog --gen-secret
secret=CHANGE_ME_GENERATE_A_REAL_SECRET

# Input device - rotary knob (TE300K channel switch)
device=/dev/input/event4

# Input device - side buttons (KEY_F2=ident, KEY_F3=emergency)
# Remove or leave empty to disable buttons
button_device=/dev/input/event3

# Input device - RSM PTT (telo_ptt, external speaker-mic)
# Remove or leave empty to disable RSM PTT
ptt_device=/dev/input/event2

# --- GPS position reporting (optional) ---
# GPS is NOT configured here. It is enabled per radio by creating
# /data/local/tmp/loc.conf containing the update interval in seconds:
#   adb shell "echo 30 > /data/local/tmp/loc.conf"
# Delete the file to disable. See "GPS tracking" in the README.

# --- Custom APN (optional) ---
# Some (usually older, locked-down) radios ship an outdated carrier APN that
# works at home but fails when roaming abroad - data dies the moment you cross a
# border even though the network still registers. When on, the radio installs
# your operator's correct APN on boot (after the SIM registers): it disables
# every APN it finds, then adds and selects the one below - so you never have to
# know the stale APN's name. Requires the platform-signed apn-setter app (see
# "Custom APN" in the README).
#
# Master switch. false = the APN is never touched (radio behaves like stock).
# true = apply the settings below on every boot. This one line decides it all.
custom_apn_mode=false
# The APN string to use (ask your operator; many consumer plans use "internet").
apn=
# Your operator's MCC and MNC. Find them with:
#   adb shell getprop gsm.sim.operator.numeric   (first 3 digits = MCC, rest = MNC)
apn_mcc=
apn_mnc=
# Human-readable label for the APN (optional).
apn_name=Custom APN
# IP family: IP (IPv4), IPV6, or IPV4V6.
apn_protocol=IPV4V6
apn_roaming_protocol=IP
# APN type - leave as-is unless your operator needs something specific.
apn_type=default,supl
