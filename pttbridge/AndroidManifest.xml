<?xml version="1.0" encoding="utf-8"?>
<manifest android:versionCode="4" android:versionName="1.3" package="com.pttbridge" platformBuildVersionCode="23" platformBuildVersionName="6.0.1"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.DIAGNOSTIC" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Signature-level, and granted only because this APK is signed with the
         device's platform key - the same reason DIAGNOSTIC works. Used by Inject
         to press ENTER on Mumla's server list at boot, on radios where the
         sendevent approach is blocked by SELinux. -->
    <uses-permission android:name="android.permission.INJECT_EVENTS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <application android:label="PTT Bridge">
        <service android:name=".BridgeService" android:exported="true">
            <intent-filter>
                <action android:name="com.pttbridge.START" />
            </intent-filter>
        </service>
        <!-- Buttons as framework KeyEvents, for radios whose SELinux policy
             denies an app uid /dev/input. Inert until it is switched on in
             Settings.Secure.enabled_accessibility_services, so radios on the
             evdev path ship it and never bind it. -->
        <service android:name=".KeyService"
                 android:exported="true"
                 android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice"
                       android:resource="@xml/porto_keys" />
        </service>
        <!-- Idle screen. No launcher filter on purpose: it is started by name
             (am start -n com.pttbridge/.ScreenActivity) so it does not add an
             icon to radios that already have a vendor idle screen. -->
        <activity android:name=".ScreenActivity"
                  android:exported="true"
                  android:label="Porto"
                  android:launchMode="singleTask"
                  android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />
        <receiver android:name=".BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
