<?xml version="1.0" encoding="utf-8"?>
<!--
  Accessibility service configuration for KeyService.

  canRequestFilterKeyEvents together with flagRequestFilterKeyEvents is what
  makes onKeyEvent() fire at all. The capability can only be declared here, not
  set at runtime, and without both the service binds successfully and then
  silently never sees a key - which looks exactly like a broken button.

  No useful accessibility event types are requested: the service never inspects
  the UI, it only wants the hardware buttons. typeWindowStateChanged is the
  cheapest non-empty value, since the framework expects the attribute to be set.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRequestFilterKeyEvents"
    android:canRequestFilterKeyEvents="true"
    android:notificationTimeout="0" />
